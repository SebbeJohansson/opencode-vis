{
  "name": "openui",
  "version": "0.2.0",
  "description": "openui - OpenCode Visualizer",
  "keywords": [
    "opencode",
    "webui"
  ],
  "homepage": "https://sebbejohansson.github.io/openui",
  "license": "MIT",
  "author": "Sebastian Johansson",
  "repository": {
    "url": "https://github.com/SebbeJohansson/openui"
  },
  "bin": "server.js",
  "files": [
    "server.js",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "prepack": "vite build",
    "format": "oxfmt",
    "lint": "oxlint && vue-tsc --noEmit",
    "dev": "vite dev",
    "dev:full": "npx tsx server-claude/index.ts",
    "dev:full:prod": "NODE_ENV=production npx tsx server-claude/index.ts",
    "dev:full:check": "tsc --noEmit --project server-claude/tsconfig.json",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.12.3"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@kikuchan/hexdump": "0.1.0-alpha.9",
    "@shikijs/markdown-it": "^3.22.0",
    "@shikijs/transformers": "^3.22.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.24",
    "happy-dom": "^20.13.2",
    "markdown-it": "^14.1.1",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "oxlint-tsgolint": "^0.12.2",
    "postcss": "^8.5.6",
    "shiki": "^3.22.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.28",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "yarn@4.17.0"
}
