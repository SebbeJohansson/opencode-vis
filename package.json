{
  "name": "openui",
  "version": "0.2.0",
  "description": "openui - OpenCode Visualizer",
  "keywords": [
    "opencode",
    "webui"
  ],
  "homepage": "https://sebbejohansson.github.io/openui",
  "license": "MIT",
  "author": "Sebastian Johansson",
  "repository": {
    "url": "https://github.com/SebbeJohansson/openui"
  },
  "bin": "server.js",
  "files": [
    "server.js",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:full": "npx tsx server-claude/index.ts",
    "dev:full:prod": "NODE_ENV=production npx tsx server-claude/index.ts",
    "dev:full:check": "tsc --noEmit --project server-claude/tsconfig.json",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepack": "nuxt build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn lint && yarn format:check && yarn typecheck && yarn test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.12.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@iconify/vue": "^5.0.0",
    "@kikuchan/hexdump": "0.1.0-alpha.9",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/test-utils": "^4.2.0",
    "@shikijs/markdown-it": "^3.22.0",
    "@shikijs/transformers": "^3.22.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.2.3",
    "@xterm/xterm": "^6.0.0",
    "happy-dom": "^20.13.2",
    "markdown-it": "^14.1.1",
    "nuxt": "^4.5.2",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "shiki": "^3.22.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "yarn@4.17.0"
}
